[Unit]
Description=TFT Kimi S19 read-only data service
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/tft-kimi
ExecStart=/usr/bin/node /root/tft-kimi/server/http.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadOnlyPaths=/root/tft-kimi

[Install]
WantedBy=multi-user.target
